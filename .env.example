# --- Devin API (app.devin.ai -> Settings -> Devin API) ---
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/superset
GITHUB_WEBHOOK_SECRET=change-me

# --- Autopilot policy ---
AUTOFIX_LABEL=devin-autofix
MAX_CONCURRENT_SESSIONS=3
MAX_ACU_PER_SESSION=10
POLL_INTERVAL_SECONDS=30
DISPATCH_PAUSED=false
DRY_RUN=false
