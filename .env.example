# --- Devin API (app.devin.ai -> Settings -> Devin API) ---
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-org/superset
GITHUB_WEBHOOK_SECRET=change-me

# --- Autopilot policy ---
AUTOFIX_LABEL=devin-autofix
MAX_CONCURRENT_SESSIONS=3
MAX_ACU_PER_SESSION=10
POLL_INTERVAL_SECONDS=30
# Rolling 24h cap on sessions started. 8 is the value the documented run used.
DAILY_SESSION_BUDGET=8
# A session past this is treated as timed out rather than holding a slot forever.
SESSION_TIMEOUT_MINUTES=90
DISPATCH_PAUSED=false
DRY_RUN=false

# --- Cost model ---
# The baseline the dashboard compares measured Devin spend against. Modelled, not
# measured: substitute your own numbers.
ENGINEER_HOURS_PER_FINDING=1.5
ENGINEER_HOURLY_COST_USD=95
